#!/bin/sh
# Minimal init for Firecracker microVM (PID 1)

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Writable /etc overlay
mkdir -p /tmp/etc-upper /tmp/etc-work
mount -t overlay overlay -o lowerdir=/etc,upperdir=/tmp/etc-upper,workdir=/tmp/etc-work /etc 2>/dev/null
echo "nameserver 8.8.8.8" > /etc/resolv.conf
echo "127.0.0.1 localhost sandbox" > /etc/hosts

hostname sandbox
ip link set lo up 2>/dev/null

modprobe vsock 2>/dev/null
modprobe vmw_vsock_virtio_transport 2>/dev/null

# Start Go guest-agent for TCP exec (branches, legacy, network config)
/usr/local/bin/guest-agent >/dev/console 2>&1 &

# Start eval server if available
if [ -f /usr/local/lib/eval-server.js ] && command -v node >/dev/null 2>&1; then
    node /usr/local/lib/eval-server.js >/dev/console 2>&1 &
fi

# Serial agent takes over ttyS0 — primary exec path
# C binary: zero runtime overhead after snapshot restore
exec /usr/local/bin/serial-agent </dev/ttyS0 >/dev/ttyS0 2>/dev/console
